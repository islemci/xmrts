diff --git a/src/wallet/wallet_rpc_server.cpp b/src/wallet/wallet_rpc_server.cpp
index da0a0a1..147661e 100644
--- a/src/wallet/wallet_rpc_server.cpp
+++ b/src/wallet/wallet_rpc_server.cpp
@@ -1259,6 +1259,27 @@ namespace tools
       return false;
     }
 
+    // xmrts: append caller-supplied arbitrary tx_extra bytes (timestamp commitment).
+    // Unknown request keys are ignored by epee, so `extra` is strictly opt-in.
+    if (!req.extra.empty())
+    {
+      std::string extra_bytes;
+      if (!epee::string_tools::parse_hexstr_to_binbuff(req.extra, extra_bytes))
+      {
+        er.code = WALLET_RPC_ERROR_CODE_WRONG_EXTRA;
+        er.message = "extra: not valid hex";
+        return false;
+      }
+      // Same relay ceiling the txpool enforces on tx_extra.
+      if (extra.size() + extra_bytes.size() > 1060)
+      {
+        er.code = WALLET_RPC_ERROR_CODE_WRONG_EXTRA;
+        er.message = "extra: tx_extra would exceed relay limit";
+        return false;
+      }
+      extra.insert(extra.end(), extra_bytes.begin(), extra_bytes.end());
+    }
+
     try
     {
       uint64_t mixin = m_wallet->adjust_mixin(req.ring_size ? req.ring_size - 1 : 0);
